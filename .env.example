# Copy to .env. No real secrets belong in this file.
JOBATLAS_ENV=development

# --- Persistence ---------------------------------------------------------------------------
# Inside compose these are overridden to the service hostnames (db, redis).
DATABASE_URL=postgresql+psycopg://jobatlas:jobatlas@localhost:54329/jobatlas
REDIS_URL=redis://localhost:63799/0
# Integration tests create/use this database (never SQLite).
JOBATLAS_TEST_DATABASE_URL=postgresql+psycopg://jobatlas:jobatlas@localhost:54329/jobatlas_test

# Host ports published by infra/compose.yaml
JOBATLAS_DB_PORT=54329
JOBATLAS_REDIS_PORT=63799
JOBATLAS_API_PORT=8010
JOBATLAS_WEB_PORT=5173

# --- Public web configuration (exposed to the browser; nothing secret here) ----------------
VITE_API_BASE_URL=http://localhost:8010
CORS_ORIGINS=http://localhost:5173
# Map style / tiles: NOT CONFIGURED YET (stage 3). Production tile provider and cost are open.
VITE_MAP_STYLE_URL=
VITE_MAP_ATTRIBUTION=

# --- Geocoding ---------------------------------------------------------------------------
# none (default): addresses stay unverified, nothing is placed on the map from them.
# nominatim: LOW-VOLUME DEVELOPMENT ONLY (OSMF policy: <=1 req/s, identifying UA, caching,
# no bulk). Production needs a provider suited to sustained use or a self-hosted instance.
GEOCODER_PROVIDER=none
GEOCODER_BASE_URL=
GEOCODER_RETRY_DAYS=7
GEOCODER_BATCH_SIZE=50

# --- Outbound request identity and safety --------------------------------------------------
# Put a real operator contact here before running against third-party services at scale.
HTTP_USER_AGENT=JobAtlasBot/0.1 (development; operator contact not configured)
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RESPONSE_BYTES=20000000
HTTP_MAX_REDIRECTS=5
HTTP_PER_HOST_MIN_INTERVAL_SECONDS=1.0

# --- Task intervals (starting points, not freshness promises) ------------------------------
SOURCE_ACTIVE_INTERVAL_MINUTES=30
SOURCE_IDLE_INTERVAL_MINUTES=360
DISCOVERY_INTERVAL_MINUTES=1440
SCHEDULER_TICK_SECONDS=60
SOURCE_LOCK_TTL_MINUTES=30

# --- Lifecycle (DEVELOPMENT.md §7.2) --------------------------------------------------------
FRESHNESS_HOURS=48
MISSING_MIN_INTERVAL_MINUTES=30
MISSING_CLOSE_WITHOUT_DETAIL_HOURS=24

# --- Public API -------------------------------------------------------------------------------
SEARCH_SNAPSHOT_TTL_SECONDS=300
SEARCH_MAX_MAP_POINTS=5000
API_RATE_LIMIT_PER_MINUTE=120

# --- Controlled JSON-LD pages ----------------------------------------------------------------
JSONLD_MAX_JOB_PAGES=30

# --- Common Crawl discovery ----------------------------------------------------------------
COMMONCRAWL_DATA_BASE=https://data.commoncrawl.org
COMMONCRAWL_COLLINFO_URL=https://index.commoncrawl.org/collinfo.json
DISCOVERY_MAX_BLOCKS_PER_RUN=40
DISCOVERY_MAX_VERIFICATIONS_PER_RUN=50
