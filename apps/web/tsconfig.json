{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom",
      "node",
      "geojson"
    ],
    "paths": {
      "@api/*": [
        "../../packages/api-client/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../../packages/api-client/schema.d.ts"
  ]
}
